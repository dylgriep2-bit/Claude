# ── Provider selection ────────────────────────────────────────────────
# "anthropic" (default) — Claude via the Anthropic API. Note that
#   Anthropic's usage policy does NOT permit sexually explicit content,
#   so this provider can only power the default (non-explicit) persona.
# "openai-compatible" — any OpenAI-compatible /chat/completions endpoint
#   (vLLM, llama.cpp server, TGI, a hosted provider). You are responsible
#   for choosing a provider/model whose terms permit your content.
CHAT_PROVIDER=anthropic

# ── Anthropic provider ────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_api_key_here
# ANTHROPIC_MODEL=claude-opus-4-6

# ── OpenAI-compatible provider ────────────────────────────────────────
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_MODEL=your-model-name
# OPENAI_COMPAT_API_KEY=optional_key

# ── Persona ───────────────────────────────────────────────────────────
# Path to a plain-text system prompt that replaces the built-in Maya
# persona. See README.md for requirements any persona must keep.
# PERSONA_PROMPT_FILE=./persona/maya.txt
